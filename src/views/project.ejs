<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% if (project) { %>
        <p><strong>Description:</strong> <%= project.description %></p>
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { day: '2-digit', month: 'long', year: 'numeric' }) %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
        
        <% if (categories && categories.length > 0) { %>
            <div class="categories">
                <strong>Categories:</strong>
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>" class="tag"><%= category.name %></a>
                <% }) %>
            </div>
        <% } %>
    <% } else { %>
        <p>Project not found.</p>
        <a href="/projects">Back to projects</a>
    <% } %>

    <% if (isLoggedIn) { %>
    <div class="volunteer">
        <% if (isVolunteering) { %>
            <p>You are volunteering for this project.</p>
            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                <input type="hidden" name="redirectTo" value="project">
                <button type="submit" class="link-button">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit" class="link-button">Volunteer for this project</button>
            </form>
        <% } %>
    </div>
<% } %>

    <% if (user && user.role_name === 'admin') { %>
    <p><a href="/project/<%= project.project_id %>/assign-categories" class="action-link">Edit Project Categories</a></p>
    <p><a href="/edit-project/<%= project.project_id %>" class="action-link">Edit Project</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>