<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>user: <%= name %></h2>
    <p>Username: <%= email %></p>
    <p>Role: <%= role %></p>

    

    <% if (isLoggedIn) { %>
    <p><a href="/users" class="action-link">Users List</a></p>
    <% } %>

    <h2>My Volunteer Projects</h2>
<% if (volunteerProjects.length > 0) { %>
    <ul class="volunteer-list">
        <% volunteerProjects.forEach(project => { %>
            <li class="volunteer-item">
                <a class="volunteer-title" href="/project/<%= project.project_id %>"><%= project.title %></a>
                <span class="volunteer-date"><%= new Date(project.date).toLocaleDateString('en-US', { day: '2-digit', month: 'long', year: 'numeric' }) %></span>
                <span class="volunteer-org"><%= project.organization_name %></span>
                <form action="/project/<%= project.project_id %>/unvolunteer" method="POST" class="volunteer-remove">
                    <input type="hidden" name="redirectTo" value="dashboard">
                    <button type="submit" class="link-button">Remove</button>
                </form>
            </li>
        <% }) %>
    </ul>
<% } else { %>
    <p>You have not volunteered for any projects yet.</p>
<% } %>
</main>

<%- include('partials/footer') %>